# ==============================================================================
# CONTACT FORM PROCESSING BACKEND API PLATFORM - CONFIGURATION
# ==============================================================================
# Choose either OPTION A (Gmail SMTP), OPTION B (Resend API), or OPTION C (Custom SMTP).
# If no keys are provided, the system automatically runs in local simulation mode
# and safely logs all messages to server/data/inquiries.json with 0% data loss.
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Allowed CORS origins (comma-separated, or * for development)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,https://jaffreen.vercel.app

# Secret key required to access GET /api/inquiries
ADMIN_API_KEY=your_secure_admin_key_here

# Destination inbox: Where contact form inquiries should be delivered
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Authenticated Sender Address (must match your SMTP user or verified Resend domain)
EMAIL_FROM="Portfolio Inquiries" <your_email@gmail.com>

# Send automatic confirmation receipt to the client? (true / false)
SEND_AUTO_REPLY=true

# Provider mode: auto | smtp | resend
EMAIL_PROVIDER=auto

# ------------------------------------------------------------------------------
# OPTION A: GMAIL SMTP (Recommended - 100% Inbox Delivery, Free 500/day)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Paste the 16-letter App Password below (no spaces needed):
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# OPTION B: RESEND API (Top-tier developer email platform - 3,000 free/month)
# ------------------------------------------------------------------------------
# 1. Sign up at https://resend.com
# 2. Create an API key and paste below:
RESEND_API_KEY=re_your_api_key_here

# ------------------------------------------------------------------------------
# OPTION C: CUSTOM SMTP (Brevo / SendGrid / Amazon SES / Mailgun / Outlook)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

